# Local storage (never commit .env.gateway)
GATEWAY_DB_PATH=sensor_gateway/data/gateway.sqlite3

# Device identity
GATEWAY_DEVICE_ID=pot-scale-01
GATEWAY_DEVICE_NAME=PlanTalk prototype scale
GATEWAY_HARDWARE_MODEL=
GATEWAY_FIRMWARE_VERSION=0.2.0
GATEWAY_PLANT_ID=

# Stability filter
GATEWAY_STABILITY_WINDOW=20
GATEWAY_STABILITY_MAX_RANGE_G=3.0
GATEWAY_EMIT_INTERVAL_SECONDS=600
GATEWAY_UPLOAD_BATCH_SIZE=50

# Adaptive upload: detect a persistent stable weight increase, then sample faster.
GATEWAY_WATERING_DETECTION_ENABLED=true
GATEWAY_WATERING_MIN_INCREASE_G=10
GATEWAY_WATERING_CONFIRM_SECONDS=30
GATEWAY_WATERING_BURST_INTERVAL_SECONDS=60
GATEWAY_WATERING_BURST_DURATION_SECONDS=1800

# Arduino serial connection. Use `python -m sensor_gateway ports` to find COM port.
GATEWAY_SERIAL_PORT=auto
GATEWAY_SERIAL_BAUD=9600
GATEWAY_SERIAL_TIMEOUT_SECONDS=2.5
GATEWAY_SERIAL_RECONNECT_SECONDS=3

# Optional raw load-cell conversion: weight_g = (raw - zero) * grams_per_unit
GATEWAY_RAW_ZERO_VALUE=
GATEWAY_RAW_GRAMS_PER_UNIT=

# JSON field mapping. Dot paths such as data.weight are supported.
GATEWAY_FIELD_TIMESTAMP=measured_at
GATEWAY_FIELD_WEIGHT=weight_g
GATEWAY_FIELD_RAW_VALUE=raw_sensor_value
GATEWAY_FIELD_SEQUENCE=sequence_no
GATEWAY_FIELD_TEMPERATURE=temperature_c
GATEWAY_FIELD_HUMIDITY=humidity_percent
GATEWAY_FIELD_LIGHT_LUX=light_lux
GATEWAY_FIELD_LIGHT_PPFD=light_ppfd
GATEWAY_FIELD_STATUS=status
GATEWAY_FIELD_HX711_READY=hx711_ready

# Supabase remote upload. Use a publishable key and a dedicated test user only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

